services:
  - type: web
    name: kiss-fatloss
    env: python
    plan: free
    repo: https://github.com/bigsmooth/kiss-fatloss
    branch: main
    buildCommand: pip install -r requirements.txt
    startCommand: streamlit run fatloss.py --server.port $PORT --server.address 0.0.0.0
    autoDeploy: true
    envVars:
      - key: PYTHON_VERSION
        value: 3.11.9
